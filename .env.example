PORT=3000

# gRPC Identity Service
GRPC_IDENTITY_HOST=0.0.0.0
GRPC_IDENTITY_PORT=50051

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=microservices

# NATS
NATS_CLIENT_PORT=4222
NATS_MGMT_PORT=8222
NATS_SERVERS=nats://localhost:4222
# Optional auth
# NATS_USER=myuser
# NATS_PASS=mypass
# Optional TLS (set to 'true' to enable)
# NATS_TLS=true

# NATS JetStream — Stream (used by identity-service producer)
NATS_STREAM_NAME=IDENTITY_EVENTS
NATS_STREAM_SUBJECTS=user.>,auth.>
# Storage and retention (file|memory, limits|interest|workqueue)
NATS_STORAGE_TYPE=file
NATS_RETENTION_POLICY=limits

# NATS JetStream — Consumer (used by gateway-service consumer)
NATS_CONSUMER_DURABLE_NAME=gateway-projections
NATS_ACK_WAIT_MS=30000
NATS_MAX_DELIVER=5

# Redis
REDIS_PORT=6379

# Environment
NODE_ENV=development

# gRPC Auth Service
GRPC_AUTH_HOST=0.0.0.0
GRPC_AUTH_PORT=50052

# JWT
JWT_SECRET=super-secret-key-for-dev
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=

