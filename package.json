{
  "name": "nestjs-ecommerce-microservices",
  "author": "Mahdi Vajdi",
  "description": "Production-grade e-commerce microservices monorepo built with NestJS, DDD, Hexagonal Architecture, CQRS, gRPC, NATS JetStream, and Transactional Outbox.",
  "packageManager": "yarn@4.18.0",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build --all",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "start": "nest start",
    "prestart:dev": "rm -rf dist",
    "start:dev": "concurrently -k -c \"cyan,magenta,yellow\" \"yarn:start:dev:gateway\" \"yarn:start:dev:user\" \"yarn:start:dev:auth\"",
    "start:dev:gateway": "nest start gateway-service --watch",
    "start:dev:user": "nest start user-service --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:prod:gateway": "node dist/apps/gateway-service/main",
    "start:prod:user": "node dist/apps/user-service/main",
    "start:prod:auth": "node dist/apps/auth-service/main",
    "migration:generate:user": "yarn build && typeorm-ts-node-commonjs migration:generate -d apps/user-service/src/infrastructure/persistence/data-source.ts",
    "migration:run:user": "typeorm-ts-node-commonjs migration:run -d apps/user-service/src/infrastructure/persistence/data-source.ts",
    "migration:revert:user": "typeorm-ts-node-commonjs migration:revert -d apps/user-service/src/infrastructure/persistence/data-source.ts",
    "migration:generate:auth": "yarn build && typeorm-ts-node-commonjs migration:generate -d apps/auth-service/src/infrastructure/persistence/data-source.ts",
    "migration:run:auth": "typeorm-ts-node-commonjs migration:run -d apps/auth-service/src/infrastructure/persistence/data-source.ts",
    "migration:revert:auth": "typeorm-ts-node-commonjs migration:revert -d apps/auth-service/src/infrastructure/persistence/data-source.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/infrastructure(|/.*)$": "<rootDir>/libs/infrastructure/src/$1"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nats": "2.29.3",
    "pg": "8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.5.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.67.0"
  }
}
